print("*********** Smart Home Climate Monitoring System ***********")

climate = input("Enter climate condition (hot/cold/normal): ").lower().strip()

if climate == "hot":
    print("Climate is hot")
    print("Recommendation: Turn ON AC")

elif climate == "cold":
    print("Climate is cold")
    print("Recommendation: Activate Heater")

elif climate == "normal":
    print("Climate is normal")
    print("Recommendation: Idle (No action needed)")

else:
    print(f"Invalid climate condition: '{climate}'")
    print("Please enter hot, cold, or normal.")
